# OpenShift sandbox image — community base + supervisor binary.
#
# On vanilla k3s the supervisor is side-loaded via hostPath from the node
# filesystem.  OpenShift's SELinux policy blocks execution of hostPath
# binaries labeled `var_t`, so we bake the supervisor directly into the
# sandbox image instead.
#
# Build:
#   docker build -t openshell-sandbox-openshift \
#     -f deploy/docker/Dockerfile.sandbox-openshift .

FROM ghcr.io/nvidia/openshell/cluster:latest AS supervisor-source

FROM ghcr.io/nvidia/openshell-community/sandboxes/base:latest

COPY --from=supervisor-source \
    /opt/openshell/bin/openshell-sandbox \
    /opt/openshell/bin/openshell-sandbox

USER sandbox
ENTRYPOINT ["/bin/bash"]
