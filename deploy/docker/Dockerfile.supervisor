# Minimal image containing only the supervisor binary (~14 MB).
# Used as an init container source on platforms where hostPath sideloading
# is not viable (e.g. OpenShift with SELinux enforcing).
#
# Build:
#   podman build --platform linux/amd64 \
#     -t quay.io/<user>/openshell-supervisor:latest \
#     -f deploy/docker/Dockerfile.supervisor .

FROM ghcr.io/nvidia/openshell/cluster:latest AS source

FROM scratch
COPY --from=source /opt/openshell/bin/openshell-sandbox /openshell-sandbox
ENTRYPOINT ["/openshell-sandbox"]
